{
  "name": "medication-tracker-tests",
  "version": "1.0.0",
  "description": "药品记录管理系统测试套件",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:gap": "jest --coverage --coverageReporters=text-summary | tee coverage-gap-report.txt"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "pages/**/*.js",
      "utils/**/*.js",
      "!pages/**/*.wxml",
      "!pages/**/*.wxss",
      "!app.js",
      "!app.json",
      "!app.wxss"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1"
  }
}
