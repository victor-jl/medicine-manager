{
  "name": "medicine-reminder",
  "version": "1.0.0",
  "description": "药品记录管理系统",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "pages/**/*.js",
      "!**/__tests__/**",
      "!**/node_modules/**"
    ],
    "setupFilesAfterEnv": [
      "./__tests__/setup.js"
    ]
  }
}