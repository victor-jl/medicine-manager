{
  "name": "medication-tracker",
  "version": "1.0.0",
  "description": "用药记录微信小程序",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "!utils/**/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
